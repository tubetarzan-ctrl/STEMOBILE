# Copy to .env.local. Every integration falls back to a mock when its keys are
# empty, so `npm run dev` works with nothing filled in (storefront uses demo data).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Repair passcodes are AES-256-GCM encrypted in the app layer (32-byte key, base64)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSCODE_ENCRYPTION_KEY=

# Cron routes require: Authorization: Bearer $CRON_SECRET (Vercel Cron sends it)
CRON_SECRET=

# Media
UPLOADTHING_TOKEN=

# Email
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
EMAIL_FROM="StarTech Electronics <hello@startech.pk>"

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OWNER_WHATSAPP=

# Bank transfer details shown to customers at checkout (manual transfer + receipt upload)
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=

# Payments: payfast | safepay | mock
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SECRET=

# Courier: mock (add postex | leopards | trax behind CourierProvider)
COURIER_PROVIDER=mock
COURIER_API_KEY=

# Google reviews
GOOGLE_PLACES_API_KEY=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
NEXT_PUBLIC_GOOGLE_PLACE_ID=

YOUTUBE_API_KEY=
INSTAGRAM_GRAPH_TOKEN=

# AI (OpenAI). Empty = FAQ answer-bank only.
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
SENTRY_DSN=

# Stock photo downloader (npm run stock:fetch) — local only
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional licensed 3D phone model for the hero, e.g. /models/hero-phone.glb
NEXT_PUBLIC_HERO_GLB=

# IMEI check (paid, optional) — e.g. imeicheck.net
IMEI_CHECK_API_KEY=
IMEI_CHECK_SERVICE_ID=
IMEI_CHECK_API_URL=
